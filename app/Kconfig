mainmenu "rtoscope"

choice RTOSCOPE_DEMO
	prompt "Demo to run"
	default RTOSCOPE_DEMO_INVERSION

config RTOSCOPE_DEMO_PERIODIC
	bool "Step 2: three periodic threads"

config RTOSCOPE_DEMO_INVERSION
	bool "Step 3: priority inversion"

endchoice

config RTOSCOPE_PERIODIC_HYPERPERIODS
	int "Hyperperiods to run before dumping the trace"
	depends on RTOSCOPE_DEMO_PERIODIC
	range 1 4
	default 2
	help
	  One hyperperiod of the step 2 task set (3000 ms) is about 280
	  trace records; the ring buffer (TRACE_LEN in trace.c) holds 2048.

config RTOSCOPE_PERIODIC_RUNS
	int "Runs per boot"
	depends on RTOSCOPE_DEMO_PERIODIC
	range 1 1000
	default 1
	help
	  Repeat the whole run (fresh release time, new threads, new trace)
	  this many times in one boot, dumping the trace after each, then
	  print "# rtoscope runs done".

config RTOSCOPE_MONITOR
	bool "On-device deadline and blocking-time monitor (src/monitor.c)"
	help
	  Inversion demo: H gets a 100 ms deadline and a 60 ms mutex blocking
	  budget. Periodic demo: every job's deadline (= period) is monitored.
	  Findings are "mon" records in the trace.

config RTOSCOPE_INJECT_OVERRUN
	bool "Periodic demo: M's 3rd job overruns by 300 ms (each run)"
	depends on RTOSCOPE_DEMO_PERIODIC
	help
	  A controlled deadline miss for the monitor to catch.

config RTOSCOPE_WDT
	bool "Periodic demo: task watchdog channel per thread, hardware fallback"
	depends on RTOSCOPE_DEMO_PERIODIC
	select WATCHDOG
	select TASK_WDT
	select HWINFO
	select REBOOT
	help
	  Each thread feeds its own task_wdt channel (timeout 2x its period) at
	  the end of every job; TIMG0's hardware watchdog backs up the task
	  watchdog itself. The boot banner reports the reset cause and any "last
	  words" the previous boot left in RTC memory.

choice RTOSCOPE_WDT_TEST
	prompt "Watchdog test fault"
	depends on RTOSCOPE_WDT
	default RTOSCOPE_WDT_TEST_NONE

config RTOSCOPE_WDT_TEST_NONE
	bool "None: a healthy run must never trip the watchdog"

config RTOSCOPE_WDT_TEST_STARVE
	bool "M spins (preemptible) from its 4th job: task watchdog catches it"

config RTOSCOPE_WDT_TEST_HANG
	bool "M spins with interrupts locked from its 4th job: hardware watchdog"

endchoice

if RTOSCOPE_DEMO_INVERSION

choice RTOSCOPE_LOCK
	prompt "Lock protecting the shared resource"
	default RTOSCOPE_LOCK_MUTEX_PI

config RTOSCOPE_LOCK_MUTEX_PI
	bool "k_mutex with priority inheritance"

config RTOSCOPE_LOCK_MUTEX_NO_PI
	bool "k_mutex with priority inheritance compiled out"

endchoice

config RTOSCOPE_M_WORK_MS
	int "CPU time the medium thread burns (ms)"
	default 200

endif

# A ceiling at or below the idle priority (K_LOWEST_THREAD_PRIO, which is
# NUM_PREEMPT_PRIORITIES) compiles k_mutex priority inheritance out.
# Defaults given here take precedence over the kernel's own default.
config PRIORITY_CEILING
	default NUM_PREEMPT_PRIORITIES if RTOSCOPE_LOCK_MUTEX_NO_PI

source "Kconfig.zephyr"
